# Copy to .env next to docker-compose.yml. Never commit .env.
# Used by docker compose, deploy.py, and vpnconfig.py.

# Public (or LAN) address of the Linux instance. Client Endpoint + deploy SSH.
VPN_HOST=203.0.113.10
VPN_DEPLOY_USER=deploy
VPN_DEPLOY_SSH_PORT=22
# Optional: VPN_DEPLOY_SSH_KEY=/home/deploy/.ssh/id_ed25519

# local | remote  (deploy.sh also honors --local / --remote)
DEPLOY_TARGET=remote

# WireGuard
WG_SERVER_ADDRESS=10.13.13.1/24
WG_LISTEN_PORT=51820
WG_TUN_IF=wg0
# Comma-separated. Order assigns 10.13.13.2, .3, … Append names (ipad, android).
WG_PEERS=laptop
# false = SSH + nginx on 10.13.13.0/24 only. true = send all IPv4 (HTTP/HTTPS) out this box.
WG_FULL_TUNNEL=false
# Optional override (comma-separated CIDRs). Empty = derived from WG_FULL_TUNNEL.
WG_CLIENT_ALLOWED_IPS=
# Optional. Empty = autodetect default route on the instance.
WG_WAN_INTERFACE=
WG_PERSISTENT_KEEPALIVE=25
# Set if you want DNS in the client conf without full tunnel.
WG_CLIENT_DNS=
# WG_ENDPOINT defaults to VPN_HOST:WG_LISTEN_PORT
# WG_ENDPOINT=203.0.113.10:51820

# nginx on the tunnel IP only (not published on the public NIC).
# WG_LISTEN_ADDR must be the host IP of WG_SERVER_ADDRESS (the part before /).
WG_HTTP_PORT=8080
WG_LISTEN_ADDR=10.13.13.1

# Host sshd port (lock-ssh). Existing sessions stay up until they reconnect.
HOST_SSH_PORT=22

# Optional HTTP MFA on the tunnel (TOTP + passkeys / security keys). No IdP.
# false = off. true = nginx asks /mfa/ before extra HTTP; enroll TOTP per peer.
WG_MFA=false
WG_MFA_HOST=vpn.ops
WG_MFA_TTL_HOURS=12
