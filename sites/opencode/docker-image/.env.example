# Copy to .env and fill values. Never commit .env — it is gitignored.
# This file is read by `docker compose` (env_file) and by ./deploy.sh.
# Leave unknown providers blank.

# --- Build args (change here or export before build) ---
NODE_VERSION=24
WITH_JAVA=false
WITH_BUN=true

# --- App ---
NODE_ENV=development

# --- Ports (host:container) — change if they clash ---
PORT_3000=3000
PORT_5173=5173
PORT_8080=8080
PORT_8000=8000
PORT_4096=4096

# --- Provider keys for opencode models ---
# Your opencode.json uses: xai/grok-4.6#max, opencode-go/muse-spark-1.2, opencode-go/glm-5.3
# Map each provider to its env var. opencode reads these at runtime.
# Keep only what you use; blank lines are fine.

# xAI Grok
XAI_API_KEY=

# Anthropic (if any model routes through it)
ANTHROPIC_API_KEY=

# OpenAI (if any model routes through it)
OPENAI_API_KEY=

# opencode-go / custom gateway (check `opencode auth` output for exact var name)
OPENCODE_GO_API_KEY=
# Some setups use OPENCODE_API_KEY instead:
# OPENCODE_API_KEY=

# GitHub CLI (gh auth) — optional, for agents that push/pull
GITHUB_TOKEN=

# Add other provider keys as needed:
# GOOGLE_API_KEY=
# MISTRAL_API_KEY=
# OPENROUTER_API_KEY=
