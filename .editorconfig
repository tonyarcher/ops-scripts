# House style: 4-space indent, LF, no tabs.
# Editors, shfmt, and PSScriptAnalyzer all read this file.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{sh,bash}]
indent_size = 4

[*.ps1]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# PowerShell 5.1 reads a BOM-less UTF-8 .ps1 as ANSI, which mangles any
# non-ASCII comment. Keep the BOM so both PowerShell lines stay readable.
[*.ps1]
charset = utf-8-bom

[Makefile]
indent_style = tab
